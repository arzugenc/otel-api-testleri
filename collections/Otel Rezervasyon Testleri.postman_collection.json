              "pm.test(\"Rezervasyon oluşturuldu - 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nvar gelenCevap = pm.response.json();\r\npm.environment.set(\"rezervasyonNo\", gelenCevap.bookingid);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
