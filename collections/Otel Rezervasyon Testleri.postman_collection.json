      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 1. Güncelleme başarılı mı (200 OK)?\r\npm.test(\"Rezervasyon başarıyla güncellendi - Durum 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// 2. Fiyat ve istek bilgisi güncellendi mi?\r\npm.test(\"Güncellenen veriler doğru yansıdı\", function () {\r\n    var yanit = pm.response.json();\r\n    pm.expect(yanit.totalprice).to.eql(950);\r\n    pm.expect(yanit.additionalneeds).to.eql(\"Aksam Yemegi ve Otopark\");\r\n});"
            ]
          }
        }
      ],
