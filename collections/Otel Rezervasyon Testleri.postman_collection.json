    {
      "name": "03-Rezervaasyon detaylarını getir",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 1. İstek başarılı mı (200 OK)?\r\npm.test(\"Rezervasyon detayları başarıyla getirildi - Durum 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// 2. Dönen veriler doğru kişiye mi ait?\r\npm.test(\"Müşteri adı ve soyadı doğru doğrulanıyor\", function () {\r\n    var yanit = pm.response.json();\r\n    pm.expect(yanit.firstname).to.eql(\"Ahmet\");\r\n    pm.expect(yanit.lastname).to.eql(\"Yilmaz\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{anaUrl}}/booking/{{rezervasyonNo}}",
          "host": [
