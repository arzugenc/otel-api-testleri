  "item": [
    {
      "name": "01 - Giris Yap ve Token Al",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// 1. Sunucu başarılı döndü mü (Status 200)?\r\npm.test(\"Giriş başarılı - Durum 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n// 2. Gelen cevaptaki token'ı ortama otomatik yaz\r\nvar cevap = pm.response.json();\r\npm.environment.set(\"girisAnahtari\", cevap.token);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"username\": \"admin\",\r\n  \"password\": \"password123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{anaUrl}}/auth",
          "host": [
            "{{anaUrl}}"
          ],
          "path": [
            "auth"
          ]
        }
      },
      "response": []
    },
    {
